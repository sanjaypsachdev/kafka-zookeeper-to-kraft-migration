# Local virtualenvs — rebuilt inside the image from uv.lock
.venv/
**/.venv/

# Python caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Secrets / local-only config — never bake into the image
.env
*.env
!.env.example

# Tooling / editor cruft
.python-version
.DS_Store
.git/
.gitignore

# Container build artifacts
Dockerfile
.dockerignore
openshift/
README.md
