# LLM configuration for the agent, wired in via `envFrom`. Copy to secret-llm.yaml,
# fill in the values, and apply. src/config.py reads these env vars directly.
#
# This example targets OpenShift AI model serving (in-cluster, OpenAI-compatible
# vLLM endpoint). No external API calls are made.
apiVersion: v1
kind: Secret
metadata:
  name: kafka-migration-agent-llm
  labels:
    app: kafka-migration-agent
type: Opaque
stringData:
  LLM_PROVIDER: "openai"

  # The model name as served by your OpenShift AI InferenceService.
  LLM_MODEL: "REPLACE_WITH_SERVED_MODEL_NAME"

  # OpenAI-compatible endpoint of the served model. Use either:
  #   - the internal Service:  https://<isvc>-predictor.<ns>.svc.cluster.local:8443/v1
  #   - or the external Route: https://<isvc>-<ns>.apps.<cluster-domain>/v1
  # The path must end in /v1 for the OpenAI-compatible API.
  OPENAI_BASE_URL: "https://REPLACE_WITH_MODEL_ENDPOINT/v1"

  # Bearer token accepted by the model-serving endpoint (e.g. a ServiceAccount
  # token with access to the InferenceService). If your endpoint does not require
  # auth, set any non-empty placeholder (the OpenAI client requires a value).
  OPENAI_API_KEY: "REPLACE_WITH_MODEL_SERVING_TOKEN"

  # --- Alternative: external Anthropic API (egress to api.anthropic.com) -------
  # LLM_PROVIDER: "anthropic"
  # LLM_MODEL: "claude-opus-4-8"
  # ANTHROPIC_API_KEY: "sk-ant-..."
