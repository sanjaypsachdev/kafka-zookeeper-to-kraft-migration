# ---------------------------------------------------------------------------
# Model Configuration
# ---------------------------------------------------------------------------

# Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Model name — examples:
#   Anthropic : claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5-20251001
#   OpenAI    : gpt-4o, gpt-4o-mini
#   Compatible: llama-3.1-70b (with OPENAI_BASE_URL pointing at your server)
LLM_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# Anthropic (used when LLM_PROVIDER=anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# OpenAI / OpenAI-compatible (used when LLM_PROVIDER=openai)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Base URL override — leave blank for openai.com.
# Set to your local/cloud endpoint for compatible APIs:
#   Ollama  : http://localhost:11434/v1
#   vLLM    : http://localhost:8000/v1
#   Azure   : https://<resource>.openai.azure.com/openai/deployments/<deployment>/
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Optional: OpenShift credentials
# Leave blank if you are already logged in via `oc login`.
# ---------------------------------------------------------------------------
# OPENSHIFT_SERVER=https://api.cluster.example.com:6443
# OPENSHIFT_TOKEN=sha256~...
